<!-- Custom Detection Rules -->
<group name="custom_detections,">

  <rule id="100001" level="12">
    <if_group>windows</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)powershell\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(encodedcommand|bypass|hidden|downloadstring|iex|invoke-expression)</field>
    <description>Suspicious PowerShell execution detected - T1059.001</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>attack,</group>
  </rule>

  <rule id="100002" level="12" frequency="5" timeframe="60">
    <if_matched_sid>60122</if_matched_sid>
    <description>Multiple failed logons detected - possible brute force T1110</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>attack,authentication_failed,</group>
  </rule>

  <rule id="100003" level="15">
    <if_group>sysmon</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x1010|0x1410|0x1438|0x143a</field>
    <description>Possible credential dumping via LSASS access - T1003.001</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>attack,credential_access,</group>
  </rule>

  <rule id="100004" level="10">
    <if_group>windows</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)schtasks\.exe</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Scheduled task created - possible persistence T1053.005</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>attack,persistence,</group>
  </rule>

</group>

<!-- False Positive Exclusions -->
<group name="fp_exclusions,">

  <!-- Exclude Windows Update DLL activity -->
  <rule id="100010" level="0">
    <if_sid>92219</if_sid>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)SoftwareDistribution</field>
    <description>FP: Windows Update DLL activity - excluded</description>
  </rule>

  <!-- Exclude normal Windows logon success -->
  <rule id="100011" level="0">
    <if_sid>60106</if_sid>
    <field name="win.eventdata.logonType" type="pcre2">^5$</field>
    <description>FP: Service logon success - excluded</description>
  </rule>

  <!-- Exclude legitimate svchost service creation -->
  <rule id="100012" level="0">
    <if_sid>92307</if_sid>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)svchost\.exe</field>
    <description>FP: Legitimate svchost service - excluded</description>
  </rule>

  <!-- Exclude software protection service -->
  <rule id="100013" level="0">
    <if_sid>60642</if_sid>
    <description>FP: Software protection scheduled task - excluded</description>
  </rule>

</group>
